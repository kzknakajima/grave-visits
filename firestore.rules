rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visits/{visitId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
                                 ['date', 'visitors', 'flowersOffered', 'cleaned', 'memo', 'createdAt', 'updatedAt']
                               )
                             && request.resource.data.date is string
                             && request.resource.data.visitors is list
                             && request.resource.data.flowersOffered is bool
                             && request.resource.data.cleaned is bool;
    }
  }
}
